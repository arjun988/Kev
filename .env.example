# Server
KEV_HOST=0.0.0.0
KEV_PORT=3000
KEV_MODEL=kev-latest
KEV_LOG_LEVEL=info

# Backend: mock | ollama | openai
KEV_BACKEND=mock

# Ollama (local default for real decisions)
KEV_OLLAMA_BASE_URL=http://127.0.0.1:11434
KEV_OLLAMA_MODEL=llama3.2

# OpenAI-compatible (OpenAI, Gemini, vLLM, Together, Groq, etc.)
# Gemini example:
#   KEV_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   KEV_OPENAI_MODEL=gemini-2.0-flash
KEV_OPENAI_BASE_URL=https://api.openai.com/v1
KEV_OPENAI_API_KEY=
KEV_OPENAI_MODEL=gpt-4o-mini

# Decision engine
KEV_READOUT_TEMPERATURE=0.85
KEV_NOUL_TEMPERATURE=1.0
KEV_CALIBRATION_PROFILE=default
KEV_STRATEGY=auto

# Optional API key for self-hosted auth (leave empty to disable)
KEV_API_KEY=

# Production DX
KEV_RATE_LIMIT=120
KEV_RATE_WINDOW_MS=60000
KEV_CACHE_SIZE=256
KEV_AUDIT=1
KEV_OTEL=0
# Optional absolute path to apps/playground (auto-discovered if empty)
KEV_PLAYGROUND_DIR=
