{
  "name": "@kev-ai/server",
  "version": "0.1.0",
  "description": "Kev Decision API server",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kev-server": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@kev-ai/backends": "workspace:*",
    "@kev-ai/core": "workspace:*",
    "@kev-ai/schema": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
