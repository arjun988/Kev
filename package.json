{
  "name": "kev",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source System One decision engine — choice, score, and noul with calibrated probabilities",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@kev-ai/server",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "bench": "tsx benchmarks/run.ts",
    "bench:heldout": "tsx benchmarks/suites/openjev-heldout/run.ts",
    "bench:ops": "tsx benchmarks/suites/ops/run.ts",
    "bench:agreement": "pnpm --filter @kev-ai/eval exec kev-eval agreement",
    "bench:multiq": "pnpm --filter @kev-ai/eval exec kev-eval multiq",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "publish:sdk": "pnpm --filter @kev-ai/sdk publish --access public --no-git-checks",
    "publish:server": "pnpm --filter @kev-ai/server publish --access public --no-git-checks",
    "publish:cli": "pnpm --filter @kev-ai/cli publish --access public --no-git-checks",
    "publish:npm": "pnpm build && pnpm publish:sdk && pnpm publish:server && pnpm publish:cli"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
