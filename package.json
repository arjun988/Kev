{
  "name": "kev",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source System One decision engine — choice, score, and noul with calibrated probabilities",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@kev-ai/server",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "bench": "tsx benchmarks/run.ts",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
